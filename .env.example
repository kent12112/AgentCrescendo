# Local development only. Generate a token with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Learn: Placeholder for the shared local API credential; setup_local.py creates the real ignored files.
# The application rejects this placeholder.
DEV_API_TOKEN=replace-with-a-random-token-at-least-32-characters
# Learn: Local development PostgreSQL connection: driver, example user/password, loopback host/port, and
# database name. These are example local credentials.
DATABASE_URL=postgresql+psycopg://crescendo:crescendo@127.0.0.1:5432/crescendo
# Learn: The server-only Next.js proxy destination. Loopback keeps the local API on this machine.
API_BASE_URL=http://127.0.0.1:8000


# Optional: live demo scripts load these from .env; exported shell values take precedence.
# Learn: Optional desktop-provider credential; an empty example makes no provider request. Keep real
# values in ignored configuration.
E2B_API_KEY=
# Learn: Optional model-provider credential; host adapters read it, never the remote desktop or frontend
# browser.
GROQ_API_KEY=
